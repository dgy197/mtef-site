---
import '../styles/global.css';
import NewsList from '../components/NewsList.astro';
---
<!DOCTYPE html>
<html lang="hu">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Hírek és közlemények — Magyar Tűzvédelmi Egyeztető Fórum (MTEF)</title>
<meta name="description" content="A Magyar Tűzvédelmi Egyeztető Fórum (MTEF) legfrissebb hírei, közleményei és szakmai bejelentései a magyarországi tűzvédelem modernizációjáról." />
<link rel="canonical" href="https://mtef.hu/hirek" />
<meta property="og:title" content="Hírek és közlemények — MTEF" />
<meta property="og:description" content="A Magyar Tűzvédelmi Egyeztető Fórum (MTEF) legfrissebb hírei, közleményei és szakmai bejelentései." />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://mtef.hu/hirek" />
<meta property="og:site_name" content="MTEF" />
<meta property="og:locale" content="hu_HU" />
<meta property="og:image" content="https://mtef.hu/assets/og-image.png" />
<link rel="icon" href="/favicon.ico?v=20260514b" sizes="any" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=20260514b" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=20260514b" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=20260514b" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20260514b" />
<link rel="manifest" href="/site.webmanifest?v=20260514b" />
<link rel="alternate" type="application/rss+xml" title="MTEF hírek" href="/hirek/rss.xml" />
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Hírek és közlemények — MTEF",
  "url": "https://mtef.hu/hirek",
  "description": "A Magyar Tűzvédelmi Egyeztető Fórum (MTEF) hírei és közleményei.",
  "publisher": {
    "@type": "Organization",
    "name": "Magyar Tűzvédelmi Egyeztető Fórum",
    "alternateName": "MTEF",
    "url": "https://mtef.hu/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://mtef.hu/assets/brand/magyar-tuzvedelmi-egyezteto-forum-mtef-logo.png",
      "width": 512,
      "height": 512,
      "caption": "Magyar Tűzvédelmi Egyeztető Fórum (MTEF) logó"
    }
  }
}
</script>
<style is:global>
  body { font-family: 'DM Sans', system-ui, sans-serif; color: #1A1D21; background: #fff; }
  .eyebrow { font-family: 'JetBrains Mono', ui-monospace, monospace; letter-spacing: 0.16em; text-transform: uppercase; }
  .hu-stripe { height: 3px; background: linear-gradient(to right, #CD2A3E 0% 33.33%, #FFFFFF 33.33% 66.66%, #436F4D 66.66% 100%); }
</style>
  <script defer src="/_vercel/insights/script.js"></script>
</head>
<body class="antialiased">

<header class="border-b border-line bg-white sticky top-0 z-50">
  <div class="max-w-4xl mx-auto px-5 sm:px-8 h-14 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5" aria-label="MTEF főoldal">
      <img src="/logos/mtef.png" alt="MTEF" class="w-8 h-8 object-contain" loading="eager"/>
      <span class="font-bold tracking-tightish text-ink text-[15px] hidden sm:block">MTEF</span>
    </a>
    <a href="/" class="text-[13px] text-warmgray hover:text-fire transition-colors">← Főoldal</a>
  </div>
</header>

<main class="max-w-4xl mx-auto px-5 sm:px-8 py-14 sm:py-20">

  <p class="eyebrow text-[11px] text-warmgray mb-4 font-semibold">Közlemények</p>
  <h1 class="font-bold tracking-tightish text-ink text-4xl sm:text-5xl leading-[1.05] mb-4">
    Hírek és közlemények
  </h1>
  <p class="text-[17.5px] text-ink/70 leading-[1.72] max-w-2xl mb-12">
    A Magyar Tűzvédelmi Egyeztető Fórum (MTEF) hivatalos közleményei, bejelentései
    és hírei a magyarországi tűzvédelmi szakmai együttműködésről.
  </p>

  <!-- Közlemény kártya -->

<!-- NEWS_LIST_START -->
<NewsList />
<!-- NEWS_LIST_END -->
</main>

<footer class="border-t border-line bg-white mt-12">
  <div class="max-w-4xl mx-auto px-5 sm:px-8 py-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <p class="text-[12.5px] text-warmgray">© 2026 Magyar Tűzvédelmi Egyeztető Fórum</p>
    <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[13px] text-warmgray">
      <li><a href="/" class="hover:text-fire transition-colors">Főoldal</a></li>
      <li><a href="/adatvedelem" class="hover:text-fire transition-colors">Adatvédelem</a></li>
      <li><a href="/sutik" class="hover:text-fire transition-colors">Sütik</a></li>
      <li><a href="/impresszum" class="hover:text-fire transition-colors">Impresszum</a></li>
      <li><a href="mailto:info@mtef.hu" class="hover:text-fire transition-colors">info@mtef.hu</a></li>
    </ul>
  </div>
  <div class="hu-stripe"></div>
</footer>

</body>
</html>
